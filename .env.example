ANTHROPIC_API_KEY=
# Optional: any Mastra model string (set the matching provider key instead)
# MODEL=openai/gpt-...

# How the router waits for a specialist's answer: stream | push | poll
A2A_TRANSPORT=stream
# Optional: override it for one specialist (A2A_TRANSPORT_<ID>, id in upper snake case)
A2A_TRANSPORT_CREDIT=push
# Needed by `push`: public URL of the router server (e.g. a tunnel to port 4111), where
# specialists send push notifications. Unset = `push` specialists are polled instead.
# `pnpm dev:push` sets it for you.
# It is also the domain and endpoint published in /.well-known/poppy.json (default localhost:4111).
# ROUTER_PUBLIC_URL=https://example.ngrok-free.app

# Signs the state of a pending approval on the router's MCP front door (at least 32 bytes).
# Unset = a new key per process, so a pending approval cannot be answered after a restart.
# MCP_REQUEST_STATE_KEY=

# Optional: send traces of every agent run to Langfuse (Project settings > API keys).
# Unset = tracing is off.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: send every LLM call through the Bifrost gateway (start it with `pnpm bifrost`).
# Unset = the servers call the provider directly. In Docker, docker-compose.yml sets it.
# BIFROST_URL=http://localhost:8080
# Only if Bifrost is set to require a virtual key:
# BIFROST_VIRTUAL_KEY=sk-bf-...
# Lets you create the first admin account of Bifrost's dashboard (http://localhost:8080).
# BIFROST_SETUP_TOKEN=

# Optional: where a server lives (<ID>_URL). Read by the router and by the UI.
# Defaults are http://localhost:4111 (router) to :4121 (credit).
# In Docker, docker-compose.yml sets all of them; values here are ignored there.
# ROUTER_URL=http://localhost:4111
# CREDIT_URL=http://localhost:4121
