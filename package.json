{
  "name": "mastra-a2a",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -c auto \"pnpm:server:*\" \"pnpm:dev:next\"",
    "server:router": "cd servers/router && mastra dev --env ../../.env",
    "server:product-eligibility": "cd servers/product-eligibility && mastra dev --env ../../.env",
    "server:loan-intake": "cd servers/loan-intake && mastra dev --env ../../.env",
    "server:borrower": "cd servers/borrower && mastra dev --env ../../.env",
    "server:declarations": "cd servers/declarations && mastra dev --env ../../.env",
    "server:income-employment": "cd servers/income-employment && mastra dev --env ../../.env",
    "server:assets": "cd servers/assets && mastra dev --env ../../.env",
    "server:liabilities": "cd servers/liabilities && mastra dev --env ../../.env",
    "server:owned-properties": "cd servers/owned-properties && mastra dev --env ../../.env",
    "server:subject-property": "cd servers/subject-property && mastra dev --env ../../.env",
    "server:credit": "cd servers/credit && mastra dev --env ../../.env",
    "dev:next": "next dev -p 3030",
    "dev:push": "./scripts/dev-push.sh",
    "bifrost": "docker compose up bifrost",
    "docker:up": "./scripts/docker.sh up",
    "docker:down": "./scripts/docker.sh down",
    "docker:logs": "./scripts/docker.sh logs"
  },
  "dependencies": {
    "@mastra/client-js": "^1.59.0",
    "@mastra/core": "^1.82.0",
    "@mastra/langfuse": "^1.6.5",
    "@mastra/mcp": "^2.8.0",
    "@mastra/observability": "^1.23.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "mastra": "^1.38.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  }
}
